# ===== Server =====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ===== Database =====
MONGO_URI=mongodb://localhost:27017/insider_threat_db

# ===== JWT =====
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# ===== Admin bootstrap (used only by seed script) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ===== ML Service =====
ML_SERVICE_URL=http://localhost:8001

# ===== Nodemailer (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=replace_with_smtp_app_password
ALERT_EMAIL_FROM="SOC Alerts <alerts@example.com>"
ALERT_EMAIL_TO=security-admin@example.com

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
