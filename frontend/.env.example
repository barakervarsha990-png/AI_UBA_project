# Environment Variables for Deployed Frontend (e.g. Vercel)
#
# If backend is deployed on Render / Railway:
# VITE_API_URL=https://<your-backend-subdomain>.onrender.com/api
# VITE_SOCKET_URL=https://<your-backend-subdomain>.onrender.com
#
# If left unset on local machine, frontend defaults to http://localhost:5050/api
VITE_API_URL=
VITE_SOCKET_URL=
